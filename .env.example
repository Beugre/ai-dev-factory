# ---------------------------------------------------------------------------
# AI Dev Factory — example environment.
# Copy to .env and fill values. NEVER commit real secrets.
# The default values below make the MOCK mode fully functional with NO
# external account required.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value

# --- Datastores ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://adf:adf@db:5432/adf
REDIS_URL=redis://redis:6379/0

# --- GitHub integration --------------------------------------------------
# Minimal PAT scopes for IssueAssignmentDispatcher: `repo` (issues+PR) and
# `read:org`. For a GitHub App use the App credentials instead of a PAT.
GITHUB_OWNER=your-github-owner
GITHUB_TARGET_REPO=your-target-repo
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_USER_TOKEN=
# agent_tasks_api | issue_assignment | manual
COPILOT_DISPATCH_MODE=manual
COPILOT_CUSTOM_AGENT=developer
COPILOT_MODEL=

# --- Discord integration -------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Comma separated Discord user IDs allowed to drive the bot.
DISCORD_ALLOWED_USER_IDS=

# --- Agent runtime -------------------------------------------------------
# mock | openai_compatible | github_agentic
AGENT_RUNTIME=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Deployment ----------------------------------------------------------
# mock | local | webhook
DEPLOYMENT_MODE=mock
STAGING_BASE_URL=http://localhost:8080
STAGING_DEPLOY_WEBHOOK_URL=

# --- n8n (optional) ------------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# --- Observability -------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Protects the /metrics endpoint. Empty means unauthenticated (local only).
METRICS_TOKEN=

# --- Notifications gateway ----------------------------------------------
# mock | discord
NOTIFICATION_GATEWAY=mock
