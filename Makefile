# AI Dev Factory — developer entrypoints.
# Most targets run inside Docker Compose; local variants are provided too.

SHELL := /bin/bash
COMPOSE := docker compose
BACKEND_DIR := packages/adf
WEB_DIR := apps/web

.DEFAULT_GOAL := help

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

.PHONY: install
install: ## Install backend + frontend dependencies locally
	python3.12 -m venv .venv || python3 -m venv .venv
	. .venv/bin/activate && pip install -U pip && pip install -e "$(BACKEND_DIR)[dev]"
	cd $(WEB_DIR) && npm install

.PHONY: dev
dev: ## Run API + web with hot reload (needs local install)
	. .venv/bin/activate && (cd $(BACKEND_DIR) && uvicorn adf.api.app:app --reload --port 8000) & \
	cd $(WEB_DIR) && npm run dev

.PHONY: up
up: ## Start the full stack with Docker Compose
	$(COMPOSE) up --build

.PHONY: down
down: ## Stop the stack and remove volumes
	$(COMPOSE) down -v

.PHONY: lint
lint: ## Run linters (ruff + eslint)
	. .venv/bin/activate && cd $(BACKEND_DIR) && ruff check .
	cd $(WEB_DIR) && npm run lint

.PHONY: typecheck
typecheck: ## Run type checkers (mypy + tsc)
	. .venv/bin/activate && cd $(BACKEND_DIR) && mypy adf
	cd $(WEB_DIR) && npm run typecheck

.PHONY: test
test: test-unit ## Run all backend + frontend tests

.PHONY: test-unit
test-unit: ## Run backend unit tests
	. .venv/bin/activate && cd $(BACKEND_DIR) && pytest -q

.PHONY: test-integration
test-integration: ## Run integration tests
	. .venv/bin/activate && cd $(BACKEND_DIR) && pytest -q -m integration

.PHONY: test-e2e
test-e2e: ## Run web end-to-end tests (Playwright)
	cd $(WEB_DIR) && npm run test:e2e

.PHONY: migrate
migrate: ## Apply database migrations
	$(COMPOSE) run --rm api alembic upgrade head

.PHONY: migration
migration: ## Create a new autogenerated migration (msg=...)
	$(COMPOSE) run --rm api alembic revision --autogenerate -m "$(msg)"

.PHONY: seed
seed: ## Seed the demo project
	$(COMPOSE) run --rm api python -m adf.cli seed

.PHONY: bootstrap-github
bootstrap-github: ## Create GitHub labels idempotently
	. .venv/bin/activate && python infra/scripts/bootstrap_github_labels.py

.PHONY: demo
demo: ## Run the full mock workflow end-to-end (no external account)
	. .venv/bin/activate && cd $(BACKEND_DIR) && python -m adf.cli demo
